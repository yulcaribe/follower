{
  "manifest_version": 3,
  "name": "Follower • Instagram Takip",
  "version": "1.1.0",
  "description": "Instagram'daki açık oturumdan takipçi taraması; Go panelinde admin girişi ve merkezi hesap geçmişi.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Follower",
    "default_popup": "popup.html"
  }
}
